{
  "name": "mailwatch",
  "version": "0.1.0",
  "private": true,
  "description": "Detecci\u00f3n y clasificaci\u00f3n de correos fraudulentos para usuarios de Gmail",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mailwatch/desktop",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "evaluar": "tsx scripts/evaluar.ts",
    "dist:win": "npm run dist:win --workspace @mailwatch/desktop"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
